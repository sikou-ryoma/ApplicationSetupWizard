<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Payload\Config\**" />
    <EmbeddedResource Remove="Payload\Config\**" />
    <None Remove="Payload\Config\**" />
    <Page Remove="Payload\Config\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Conf\config.xml" />
    <None Remove="Payload\sample\sample.txt" />
    <None Remove="Payload\test.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Conf\config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Payload\sample\sample.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Payload\test.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XmlHelper\XmlHelper.csproj" />
  </ItemGroup>

</Project>
