<UserControl x:Class="ApplicationSetupWizardLite.Views.InstallLocationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ApplicationSetupWizardLite.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- タイトル -->
        <TextBlock Grid.Row="0"
                Text="インストール先を選択してください"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#333333"
                Margin="0,0,0,12"/>


        <!-- 説明 -->
        <TextBlock Grid.Row="1"
                Text="アプリケーションをインストールするフォルダーを指定してください。"
                FontSize="14"
                Foreground="#555555"
                TextWrapping="Wrap"
                Margin="0,0,0,25"/>


        <!-- インストール先 -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                    Text="インストール先を選択："
                    FontSize="12"
                    Foreground="#333333"
                    Margin="0,0,0,8"/>

            <Grid Grid.Row="1"
                  Background="#F0F0F0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="37*"/>
                    <ColumnDefinition Width="174*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- パス -->
                <TextBlock Grid.Column="0"
                        x:Name="InstallPathTextBox"                      
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding InstallPath}"
                        Grid.ColumnSpan="2"
                        Margin="10,0,0,0">
                </TextBlock>



                <!-- 参照 -->
                <Button Grid.Column="2"
                    x:Name="BrowseButton"
                    Content="参照..."
                    Width="90"
                    Height="32"
                    Margin="8,0,0,0"
                    FontSize="13"
                    Click="BrowseButton_Click"/>


            </Grid>

        </Grid>

        
        <StackPanel Grid.Row="3"
                Margin="0,20,0,0">
            
            <TextBlock Text="以下のフォルダ構成でインストールされます："
                    FontSize="11"
                    Foreground="#333333"/>
            
            <TextBlock x:Name="FolderStructureText"
                    FontWeight="SemiBold"
                    Text="{Binding FullInstallPath}"
                    FontSize="13"
                    Margin="10,10,0,0"/>
            
        </StackPanel>

        
        <!-- 補足情報 -->
        <StackPanel Grid.Row="4"
                Margin="0,30,0,0">

            <TextBlock Text="インストールデータ容量："
                    FontSize="12"
                    Foreground="#555555"/>

            <TextBlock x:Name="DiskSpaceText"
                    Text="約 0 MB"
                    FontSize="13"
                    Foreground="#333333"
                    Margin="10,5,0,0"/>

            <CheckBox x:Name="ShortcutsCheckBox"
                      Content="デスクトップへショートカットを作成する"
                      FontSize="12"
                      IsChecked="{Binding CreateShortcut}"
                      Margin="0,25,0,0" />

            <TextBlock Text="インストール先を変更する場合は「参照...」をクリックしてください。"
                    FontSize="12"
                    Foreground="#777777"
                    Margin="0,20,0,0"/>


        </StackPanel>

    </Grid>

</UserControl>