<Window x:Class="ApplicationSetupWizardLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="セットアップ"
        Width="900"
        Height="560"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        Closing="Window_Closing">

    <Window.Resources>

        <!-- ボタン -->
        <Style x:Key="WizardButtonStyle"
               TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- 左側のステップ -->
        <Style x:Key="StepTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="396*"/>
            <ColumnDefinition Width="41*"/>
            <ColumnDefinition Width="13*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- メイン領域 -->
        <!-- ========================= -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="64*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- 左側 -->
            <!-- ========================= -->
            <Border Grid.Column="0"
                    Background="#263238">

                <Grid Margin="25">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="100"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 製品名 -->
                    <StackPanel Grid.Row="0">

                        <TextBlock x:Name="AppNameLbl1"
                                   Text="LongLongLongLongLongApplicationNameSample v1.0.0"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="セットアップ"
                                   Foreground="#B0BEC5"
                                   FontSize="13"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- ステップ -->
                    <StackPanel Grid.Row="1"
                                Margin="0,20,0,0">

                        <TextBlock x:Name="Step1"
                                   Text="●  ようこそ"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock x:Name="Step2"
                                   Text="○  インストール先"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock x:Name="Step3"
                                   Text="○  確認"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock x:Name="Step4"
                                   Text="○  インストール"
                                   Style="{StaticResource StepTextStyle}"/>

                        <TextBlock x:Name="Step5"
                                   Text="○  完了"
                                   Style="{StaticResource StepTextStyle}"/>

                    </StackPanel>


                    <!-- バージョン -->
                    <TextBlock x:Name="VersionLbl" Grid.Row="2"
                               Text="Version 1.0.0"
                               Foreground="#90A4AE"
                               FontSize="11"/>

                </Grid>

            </Border>


            <!-- ========================= -->
            <!-- 右側コンテンツ -->
            <!-- ========================= -->
            <ContentControl x:Name="ContentArea"
                            Grid.Column="1"
                            Background="White" Grid.ColumnSpan="2">
            </ContentControl>

        </Grid>


        <!-- ========================= -->
        <!-- 下部ボタン -->
        <!-- ========================= -->
        <Border
                Background="#F2F2F2"
                BorderBrush="#D0D0D0"
                BorderThickness="0,1,0,0" Grid.ColumnSpan="3" Margin="0,474,0,0" Grid.RowSpan="2">

            <Grid Margin="20,0">

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="BackButton"
                            Content="＜ 戻る"
                            Style="{StaticResource WizardButtonStyle}"
                            IsEnabled="False"
                            Click="BackButton_Click"/>

                    <Button x:Name="NextButton"
                            Content="次へ ＞"
                            Style="{StaticResource WizardButtonStyle}"
                            Click="NextButton_Click"/>

                    <Button x:Name="CancelButton"
                            Content="キャンセル"
                            Style="{StaticResource WizardButtonStyle}"
                            Margin="20,0,0,0"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>